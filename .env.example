# Required: Instagram Graph API access token (prefer long-lived, ~60 days)
# - App Dashboard "Generate token" → already long-lived
# - OAuth / Business Login code exchange → short-lived (~1 hour); exchange securely outside this server
INSTAGRAM_ACCESS_TOKEN=

# Optional for Instagram Login (graph.instagram.com): IG professional ID is resolved from GET /me → user_id
# Required when using graph.facebook.com (Facebook Login for Business)
# Note: /me.id is app-scoped; /me.user_id is the IG ID used for /{user_id}/media
# INSTAGRAM_ACCOUNT_ID=

# Optional: Graph API host (default: https://graph.facebook.com)
# REQUIRED for Instagram Login tokens:
INSTAGRAM_GRAPH_API_BASE=https://graph.instagram.com

# Optional: Graph API version (default: v22.0)
# INSTAGRAM_API_VERSION=v22.0

# Optional: Instagram app secret — only needed to exchange short-lived → long-lived tokens
# INSTAGRAM_APP_SECRET=

# Optional: HTTP port (default: 3000). Hosting platforms usually set PORT.
# PORT=3000

# Required for OAuth: AuthKit origin from WorkOS Connect discovery metadata
WORKOS_AUTHKIT_ISSUER=https://your-domain.authkit.app

# Required: exact Resource Indicator registered in WorkOS, including /mcp
MCP_RESOURCE_URL=https://your-service.example.com/mcp

# MCP_AUTH_TOKEN is no longer supported. The debug and token-exchange HTTP routes are disabled.
